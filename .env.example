# Example environment for local development. Copy it to .env and adjust.
# dally does not read .env itself; load it into your shell first:
#
#   set -a; . ./.env; set +a
#
# Settings can also come from a TOML file (dally server --config dally.toml).
# Environment variables win over the file. See docs/operations.md.

# Where the server listens and stores messages. Without DALLY_STORAGE_URL,
# dally uses a local SQLite file.
DALLY_LISTEN=127.0.0.1:7070
DALLY_STORAGE_URL=postgres://postgres:dally@localhost:55432/postgres
# DALLY_STORAGE_URL=sqlite://dally.sqlite
# DALLY_STORAGE_URL=redis://localhost:56379

# Used by the dally CLI subcommands (queues, schedule, messages, dead).
DALLY_SERVER=http://127.0.0.1:7070
# DALLY_API_KEY=

# Databases for the test suite, matching compose.yaml.
DALLY_TEST_POSTGRES_URL=postgres://postgres:dally@localhost:55432/postgres
DALLY_TEST_REDIS_URL=redis://localhost:56379
